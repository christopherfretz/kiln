# Boost superproject (WP-787): included after `project(Boost)` through
# -DCMAKE_PROJECT_Boost_INCLUDE. Some Boost libraries have only b2 tests in
# a superproject build: no test/CMakeLists.txt (fusion, spirit, ...), or one
# their CMakeLists.txt adds only when built standalone (hana, yap,
# callable_traits). b2 is not a jobserver client, so instead of running b2
# this registers those tests with Boost's own `boost_test()`
# (tools/cmake/include/BoostTest.cmake), as `boost_test_jamfile()` does for
# simple Jamfiles, and they build under make and run under ctest like every
# other Boost test. The same for kiln and the clang control.
#
# KILN_BOOST_JAMFILE_LIBRARIES lists the libraries; a library that is not
# built (not in BOOST_INCLUDE_LIBRARIES) or whose CMakeLists.txt added its
# test/ directory is skipped. The tests are, per library:
#   - every `run`, `run-fail`, `compile`, `compile-fail`, `link` and
#     `link-fail` statement of every Jamfile under test/, plain or inside
#     `[ ... ]`, read from its first line only: its sources, the `<define>`
#     requirements on that line and the target name (the fifth `:` field for
#     run, the third for compile*/link*). Statements continued on later
#     lines lose what is not on the first line (args, input files, other
#     requirements); a test that needs them fails under the control too and
#     is excluded in projects.toml. A statement naming a source written with
#     a Jam variable (`$(source)`) or that does not exist (generated by a
#     Jam rule, spirit's test_headers) is skipped.
#   - for the libraries whose Jamfile builds its list with a `glob` rule
#     instead, the same list, from KILN_BOOST_JAMFILE_GLOB_<lib>: items
#     `<type>=<glob relative to test/>[|<define>|<name suffix>]`, a glob
#     starting with `**/` searched recursively (glob-tree);
#     KILN_BOOST_JAMFILE_EXCLUDE_<lib> is a regex of sources left out and
#     KILN_BOOST_JAMFILE_INCLUDE_<lib> extra include directories under test/
#     (the Jamfile's `<include>`).
# Test names are `<lib>-<subdir>_<name>`; a second statement with the same
# name (one source built twice with other requirements) is skipped. Every
# test sees every library's include/ directory, like b2's unified boost/
# header tree, so test-only dependencies (lightweight_test, lambda, phoenix)
# resolve; only header-only dependencies work this way.
set(KILN_BOOST_JAMFILE_LIBRARIES "" CACHE STRING "Boost libraries whose b2 tests are registered as CMake tests (WP-787)")
set(KILN_BOOST_JAMFILE_GLOB_type_traits "run=*_test*.cpp;compile-fail=compile_fail/*.cpp")
set(KILN_BOOST_JAMFILE_GLOB_hof "run=*.cpp")
set(KILN_BOOST_JAMFILE_GLOB_callable_traits "run=*.cpp;run=*.cpp|USE_LAZY_TYPES|__lazy")
# hana: glob-tree *.cpp minus the two-TU issues/github_75 test (not built).
set(KILN_BOOST_JAMFILE_GLOB_hana "run=**/*.cpp")
set(KILN_BOOST_JAMFILE_EXCLUDE_hana "github_75")
set(KILN_BOOST_JAMFILE_INCLUDE_hana "_include")

function(_kiln_boost_jam_add lib type src name defs)
  string(MAKE_C_IDENTIFIER "${name}" name)
  set(incs ${_KILN_BOOST_ALL_INCLUDES})
  foreach(i IN LISTS KILN_BOOST_JAMFILE_INCLUDE_${lib})
    list(PREPEND incs "${CMAKE_SOURCE_DIR}/libs/${lib}/test/${i}")
  endforeach()
  get_property(seen DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_SEEN)
  if("${lib}-${name}" IN_LIST seen)
    return()
  endif()
  set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY _KILN_BOOST_JAM_SEEN "${lib}-${name}")
  boost_test(PREFIX "${lib}" NAME "${name}" TYPE "${type}" SOURCES ${src}
    LINK_LIBRARIES Boost::${lib}
    COMPILE_DEFINITIONS ${defs}
    INCLUDE_DIRECTORIES ${incs})
endfunction()

function(_kiln_boost_jam_file lib testdir jam)
  get_filename_component(dir "${jam}" DIRECTORY)
  file(RELATIVE_PATH sub "${testdir}" "${dir}")
  file(STRINGS "${jam}" lines)
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^[ \t]*\\[?[ \t]*(run|run-fail|compile|compile-fail|link|link-fail)[ \t]+([^#]*)")
      continue()
    endif()
    set(type "${CMAKE_MATCH_1}")
    set(rest "${CMAKE_MATCH_2}")
    string(REGEX REPLACE "[];].*$" "" rest "${rest}")
    # Jam fields are separated by ` : `; CMake lists by `;`.
    string(REPLACE ":" ";" fields "${rest}")
    list(GET fields 0 srcs)
    string(REGEX MATCHALL "[^ \t]+\\.(cpp|cxx|cc|c)" srcs "${srcs}")
    if(NOT srcs OR srcs MATCHES "\\$")
      continue()
    endif()
    list(TRANSFORM srcs PREPEND "${dir}/")
    set(missing OFF)
    foreach(src IN LISTS srcs)
      if(NOT EXISTS "${src}")
        set(missing ON) # generated by a Jam rule (spirit's test_headers)
      endif()
    endforeach()
    if(missing)
      continue()
    endif()
    string(REGEX MATCHALL "<define>[^ \t]+" defs "${rest}")
    list(TRANSFORM defs REPLACE "^<define>" "")
    if(type MATCHES "^run")
      set(namefield 4)
    else()
      set(namefield 2)
    endif()
    set(name "")
    list(LENGTH fields nf)
    if(nf GREATER namefield)
      list(GET fields ${namefield} name)
      string(STRIP "${name}" name)
    endif()
    if(name STREQUAL "")
      list(GET srcs 0 first)
      get_filename_component(name "${first}" NAME_WE)
    endif()
    if(NOT sub STREQUAL "")
      set(name "${sub}_${name}")
    endif()
    _kiln_boost_jam_add("${lib}" "${type}" "${srcs}" "${name}" "${defs}")
  endforeach()
endfunction()

function(_kiln_boost_jamfile_tests)
  if(NOT BUILD_TESTING OR NOT KILN_BOOST_JAMFILE_LIBRARIES)
    return()
  endif()
  include(BoostTest)
  file(GLOB incs LIST_DIRECTORIES true "${CMAKE_SOURCE_DIR}/libs/*/include" "${CMAKE_SOURCE_DIR}/libs/numeric/*/include")
  set(_KILN_BOOST_ALL_INCLUDES ${incs})
  foreach(lib IN LISTS KILN_BOOST_JAMFILE_LIBRARIES)
    set(testdir "${CMAKE_SOURCE_DIR}/libs/${lib}/test")
    set(subdirs "")
    if(TARGET Boost::${lib})
      get_property(subdirs DIRECTORY "${CMAKE_SOURCE_DIR}/libs/${lib}" PROPERTY SUBDIRECTORIES)
    endif()
    if(NOT TARGET Boost::${lib} OR "${testdir}" IN_LIST subdirs)
      message(STATUS "kiln: ${lib}: no b2 tests registered (not built, or it has CMake tests)")
      continue()
    endif()
    if(DEFINED KILN_BOOST_JAMFILE_GLOB_${lib})
      foreach(item IN LISTS KILN_BOOST_JAMFILE_GLOB_${lib})
        string(REGEX MATCH "^([^=]+)=([^|]*)\\|?([^|]*)\\|?(.*)$" _ "${item}")
        set(type "${CMAKE_MATCH_1}")
        set(glob "${CMAKE_MATCH_2}")
        set(defs "${CMAKE_MATCH_3}")
        set(suffix "${CMAKE_MATCH_4}")
        if(glob MATCHES "^\\*\\*/(.*)$")
          file(GLOB_RECURSE srcs RELATIVE "${testdir}" "${testdir}/${CMAKE_MATCH_1}")
        else()
          file(GLOB srcs RELATIVE "${testdir}" "${testdir}/${glob}")
        endif()
        list(SORT srcs)
        if(DEFINED KILN_BOOST_JAMFILE_EXCLUDE_${lib})
          list(FILTER srcs EXCLUDE REGEX "${KILN_BOOST_JAMFILE_EXCLUDE_${lib}}")
        endif()
        foreach(src IN LISTS srcs)
          string(REGEX REPLACE "\\.[^.]*$" "" name "${src}")
          string(REPLACE "/" "_" name "${name}${suffix}")
          _kiln_boost_jam_add("${lib}" "${type}" "${testdir}/${src}" "${name}" "${defs}")
        endforeach()
      endforeach()
    else()
      file(GLOB_RECURSE jams "${testdir}/Jamfile" "${testdir}/Jamfile.v2" "${testdir}/Jamfile.jam")
      foreach(jam IN LISTS jams)
        _kiln_boost_jam_file("${lib}" "${testdir}" "${jam}")
      endforeach()
    endif()
    get_property(seen DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_SEEN)
    list(FILTER seen INCLUDE REGEX "^${lib}-")
    list(LENGTH seen n)
    message(STATUS "kiln: ${lib}: ${n} b2 tests registered from test/Jamfile*")
  endforeach()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _kiln_boost_jamfile_tests)
