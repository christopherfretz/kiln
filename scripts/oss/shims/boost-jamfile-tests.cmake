# Boost superproject (WP-787): included after `project(Boost)` through
# -DCMAKE_PROJECT_Boost_INCLUDE. Some Boost libraries have only b2 tests in
# a superproject build: no test/CMakeLists.txt (fusion, spirit, ...), or one
# their CMakeLists.txt adds only when built standalone (hana, yap,
# callable_traits). b2 is not a jobserver client, so instead of running b2
# this registers those tests with Boost's own `boost_test()`
# (tools/cmake/include/BoostTest.cmake), as `boost_test_jamfile()` does for
# simple Jamfiles, and they build under make and run under ctest like every
# other Boost test. The same for kiln and the clang control.
#
# KILN_BOOST_JAMFILE_LIBRARIES lists the libraries; a library that is not
# built (not in BOOST_INCLUDE_LIBRARIES) or whose CMakeLists.txt added its
# test/ directory is skipped. The tests are, per library:
#   - every `run`, `run-fail`, `compile`, `compile-fail`, `link` and
#     `link-fail` statement of every Jamfile under test/, plain or inside
#     `[ ... ]`, read from its first line only: its sources, the `<define>`
#     requirements on that line and the target name (the fifth `:` field for
#     run, the third for compile*/link*). Statements continued on later
#     lines lose what is not on the first line (args, input files, other
#     requirements); a test that needs them fails under the control too and
#     is excluded in projects.toml. A statement naming a source written with
#     a Jam variable (`$(source)`) or that does not exist (generated by a
#     Jam rule, spirit's test_headers) is skipped.
#   - for the libraries whose Jamfile builds its list with a `glob` rule
#     instead, the same list, from KILN_BOOST_JAMFILE_GLOB_<lib>: items
#     `<type>=<glob relative to test/>[|<define>|<name suffix>]`, a glob
#     starting with `**/` searched recursively (glob-tree);
#     KILN_BOOST_JAMFILE_EXCLUDE_<lib> is a regex of sources left out and
#     KILN_BOOST_JAMFILE_INCLUDE_<lib> extra include directories under test/
#     (the Jamfile's `<include>`).
#   - for libraries whose Jamfiles wrap those statements in their own rules
#     (thread's thread-run2-noit, serialization's test-bsl-run_files, Boost.
#     Test's boost.test-self-test; WP-804), KILN_BOOST_JAMFILE_RULES_<lib>:
#     items `<rule>=<type>|<name>|<sources>`. A statement opening with <rule>
#     is read like a builtin one from its first line, with `{N}` in each part
#     replaced by its `:` field N (0 is the first after the rule name,
#     stripped): <type> is the test type, <name> the target name (empty: the
#     first source's base name), and <sources> a `,` list of items, each a
#     field number (the field's words, `.cpp` appended to a bare identifier,
#     words that are not sources dropped) or a path template (`{1}/{2}.cpp`).
#     KILN_BOOST_JAMFILE_VARIANTS_<lib> items `<rule>|<define>|<suffix>`
#     register each test of <rule> once per item, with <define> and the name
#     suffix (serialization's per-archive runs).
#   - every test of <lib> links KILN_BOOST_JAMFILE_TARGET_<lib> (default
#     Boost::<lib>; Boost.Test's is Boost::unit_test_framework), which must
#     exist for the library to count as built, and also gets
#     KILN_BOOST_JAMFILE_DEFINES_<lib> and links KILN_BOOST_JAMFILE_LINK_<lib>: the Jamfile's project-level <define> and
#     <library> requirements (a compiled library's tests link Boost.Test's
#     unit_test_framework, thread, filesystem; WP-804).
#   - on the first line a nested `[ requires ... ]` or `[ check-target-builds
#     ... ]` is dropped (all of this compiler's features are present; a
#     check-target-builds dependency that is absent fails under the control
#     too), and so is a conditional property (`<toolset>intel:<cxxflags>x`)
#     unless its condition is `<target-os>linux`, which holds here (WP-812).
#   - KILN_BOOST_JAMFILE_SKIP_<lib> is a regex of test names (`<subdir>_<name>`,
#     before the prefix) that are not registered: asio's `*_select` reruns
#     differ only by a Jam variable's defines (WP-812).
#   - KILN_BOOST_JAMFILE_SUBSET_<lib> `<N>|<keep>` registers a deterministic
#     subset: of all the library's test names, sorted, every N-th (the 1st,
#     the N+1-th, ...) plus every name matching the regex <keep> (WP-812:
#     Boost.Math's 1300 statements).
#   - KILN_BOOST_JAMFILE_FORCE_<lib> ON registers the b2 tests even when the
#     library's CMakeLists.txt added test/ (Boost.Math's CMake tests are its
#     header compile tests only; WP-812).
# Test names are `<lib>-<subdir>_<name>`; a second statement with the same
# name (one source built twice with other requirements) is skipped. Every
# test sees every library's include/ directory, like b2's unified boost/
# header tree, so test-only dependencies (lightweight_test, lambda, phoenix)
# resolve; only header-only dependencies work this way.
set(KILN_BOOST_JAMFILE_LIBRARIES "" CACHE STRING "Boost libraries whose b2 tests are registered as CMake tests (WP-787)")
set(KILN_BOOST_JAMFILE_GLOB_type_traits "run=*_test*.cpp;compile-fail=compile_fail/*.cpp")
set(KILN_BOOST_JAMFILE_GLOB_hof "run=*.cpp")
set(KILN_BOOST_JAMFILE_GLOB_callable_traits "run=*.cpp;run=*.cpp|USE_LAZY_TYPES|__lazy")
# hana: glob-tree *.cpp minus the two-TU issues/github_75 test (not built).
set(KILN_BOOST_JAMFILE_GLOB_hana "run=**/*.cpp")
set(KILN_BOOST_JAMFILE_EXCLUDE_hana "github_75")
set(KILN_BOOST_JAMFILE_INCLUDE_hana "_include")

function(_kiln_boost_jam_add lib type src name defs)
  string(MAKE_C_IDENTIFIER "${name}" name)
  set(incs ${_KILN_BOOST_ALL_INCLUDES})
  foreach(i IN LISTS KILN_BOOST_JAMFILE_INCLUDE_${lib})
    list(PREPEND incs "${CMAKE_SOURCE_DIR}/libs/${lib}/test/${i}")
  endforeach()
  if(DEFINED KILN_BOOST_JAMFILE_SKIP_${lib} AND name MATCHES "${KILN_BOOST_JAMFILE_SKIP_${lib}}")
    return()
  endif()
  if(_KILN_BOOST_JAM_DRY)
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY _KILN_BOOST_JAM_ALL "${name}")
    return()
  endif()
  if(DEFINED _KILN_BOOST_JAM_KEEP AND NOT name IN_LIST _KILN_BOOST_JAM_KEEP)
    return()
  endif()
  get_property(seen DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_SEEN)
  if("${lib}-${name}" IN_LIST seen)
    return()
  endif()
  set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY _KILN_BOOST_JAM_SEEN "${lib}-${name}")
  boost_test(PREFIX "${lib}" NAME "${name}" TYPE "${type}" SOURCES ${src}
    LINK_LIBRARIES ${_KILN_BOOST_JAM_TARGET} ${KILN_BOOST_JAMFILE_LINK_${lib}}
    COMPILE_DEFINITIONS ${defs} ${KILN_BOOST_JAMFILE_DEFINES_${lib}}
    INCLUDE_DIRECTORIES ${incs})
endfunction()

# `{N}` in <tmpl> replaced by `:` field N of <fields> (stripped).
function(_kiln_boost_jam_subst out tmpl fields)
  list(LENGTH fields nf)
  while(tmpl MATCHES "\\{([0-9]+)\\}")
    set(i "${CMAKE_MATCH_1}")
    set(v "")
    if(nf GREATER i)
      list(GET fields ${i} v)
      string(STRIP "${v}" v)
    endif()
    string(REPLACE "{${i}}" "${v}" tmpl "${tmpl}")
  endwhile()
  set(${out} "${tmpl}" PARENT_SCOPE)
endfunction()

function(_kiln_boost_jam_file lib testdir jam)
  get_filename_component(dir "${jam}" DIRECTORY)
  file(RELATIVE_PATH sub "${testdir}" "${dir}")
  file(STRINGS "${jam}" lines)
  set(rules "run|run-fail|compile|compile-fail|link|link-fail")
  foreach(spec IN LISTS KILN_BOOST_JAMFILE_RULES_${lib})
    string(REGEX REPLACE "=.*$" "" r "${spec}")
    string(REGEX REPLACE "([.+])" "\\\\\\1" r "${r}")
    set(rules "${r}|${rules}")
  endforeach()
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^[ \t]*\\[?[ \t]*(${rules})[ \t]+([^#]*)")
      continue()
    endif()
    set(type "${CMAKE_MATCH_1}")
    set(rest "${CMAKE_MATCH_2}")
    set(jamrule "${type}")
    while(rest MATCHES "\\[[^][]*\\]")
      string(REGEX REPLACE "\\[[^][]*\\]" "" rest "${rest}")
    endwhile()
    string(REGEX REPLACE "[];].*$" "" rest "${rest}")
    string(REGEX REPLACE "\\[.*$" "" rest "${rest}")
    string(REPLACE "<target-os>linux:<" "<" rest "${rest}")
    string(REGEX REPLACE "<[^>]+>[^ \t:<]*:<[^ \t]*" "" rest "${rest}")
    # Jam fields are separated by ` : `; CMake lists by `;`.
    string(REPLACE ":" ";" fields "${rest}")
    list(LENGTH fields nf)
    set(custom "")
    foreach(spec IN LISTS KILN_BOOST_JAMFILE_RULES_${lib})
      string(FIND "${spec}" "${jamrule}=" at)
      if(at EQUAL 0)
        string(LENGTH "${jamrule}=" n)
        string(SUBSTRING "${spec}" ${n} -1 custom)
        break()
      endif()
    endforeach()
    set(srcs "")
    if(custom STREQUAL "")
      list(GET fields 0 srcs)
      string(REGEX MATCHALL "[^ \t]+\\.(cpp|cxx|cc|c)" srcs "${srcs}")
      if(type MATCHES "^run")
        set(namefield 4)
      else()
        set(namefield 2)
      endif()
      set(name "")
      if(nf GREATER namefield)
        list(GET fields ${namefield} name)
        string(STRIP "${name}" name)
      endif()
    else()
      string(REPLACE "|" ";" parts "${custom}")
      list(APPEND parts "" "" "")
      list(GET parts 0 t)
      list(GET parts 1 n)
      list(GET parts 2 sitems)
      _kiln_boost_jam_subst(type "${t}" "${fields}")
      _kiln_boost_jam_subst(name "${n}" "${fields}")
      if(sitems STREQUAL "")
        set(sitems 0)
      endif()
      string(REPLACE "," ";" sitems "${sitems}")
      foreach(item IN LISTS sitems)
        if(item MATCHES "^[0-9]+$")
          if(nf GREATER item)
            list(GET fields ${item} words)
            string(REGEX MATCHALL "[^ \t]+" words "${words}")
            foreach(w IN LISTS words)
              if(w MATCHES "^[A-Za-z0-9_]+$")
                set(w "${w}.cpp")
              endif()
              if(w MATCHES "\\.(cpp|cxx|cc|c)$" AND NOT w MATCHES "^<|//")
                list(APPEND srcs "${w}")
              endif()
            endforeach()
          endif()
        else()
          _kiln_boost_jam_subst(w "${item}" "${fields}")
          list(APPEND srcs "${w}")
        endif()
      endforeach()
      if(NOT type MATCHES "^(run|run-fail|compile|compile-fail|link|link-fail)$")
        continue()
      endif()
    endif()
    if(NOT srcs OR srcs MATCHES "\\$")
      continue()
    endif()
    list(TRANSFORM srcs PREPEND "${dir}/")
    set(missing OFF)
    foreach(src IN LISTS srcs)
      if(NOT EXISTS "${src}")
        set(missing ON) # generated by a Jam rule (spirit's test_headers)
      endif()
    endforeach()
    # A C source needs C enabled in this directory; the superproject enables
    # only CXX (regex's c_compiler_checks; container's C is its own scope).
    if(srcs MATCHES "\\.c(;|$)" AND NOT DEFINED CMAKE_C_COMPILE_OBJECT)
      set(missing ON)
    endif()
    if(missing)
      continue()
    endif()
    string(REGEX MATCHALL "<define>[^ \t]+" defs "${rest}")
    list(TRANSFORM defs REPLACE "^<define>" "")
    if(name STREQUAL "")
      list(GET srcs 0 first)
      get_filename_component(name "${first}" NAME_WE)
    endif()
    if(NOT sub STREQUAL "")
      set(name "${sub}_${name}")
    endif()
    set(variants "")
    foreach(v IN LISTS KILN_BOOST_JAMFILE_VARIANTS_${lib})
      string(FIND "${v}" "${jamrule}|" at)
      if(at EQUAL 0)
        list(APPEND variants "${v}")
      endif()
    endforeach()
    if(NOT variants)
      _kiln_boost_jam_add("${lib}" "${type}" "${srcs}" "${name}" "${defs}")
    endif()
    foreach(v IN LISTS variants)
      string(REPLACE "|" ";" vp "${v}")
      list(APPEND vp "" "")
      list(GET vp 1 vdef)
      list(GET vp 2 vsuf)
      set(vdefs ${defs} ${vdef})
      _kiln_boost_jam_add("${lib}" "${type}" "${srcs}" "${name}${vsuf}" "${vdefs}")
    endforeach()
  endforeach()
endfunction()

function(_kiln_boost_jamfile_tests)
  if(NOT BUILD_TESTING OR NOT KILN_BOOST_JAMFILE_LIBRARIES)
    return()
  endif()
  include(BoostTest)
  file(GLOB incs LIST_DIRECTORIES true "${CMAKE_SOURCE_DIR}/libs/*/include" "${CMAKE_SOURCE_DIR}/libs/numeric/*/include")
  set(_KILN_BOOST_ALL_INCLUDES ${incs})
  foreach(lib IN LISTS KILN_BOOST_JAMFILE_LIBRARIES)
    unset(_KILN_BOOST_JAM_KEEP)
    set(testdir "${CMAKE_SOURCE_DIR}/libs/${lib}/test")
    set(subdirs "")
    set(_KILN_BOOST_JAM_TARGET Boost::${lib})
    if(DEFINED KILN_BOOST_JAMFILE_TARGET_${lib})
      set(_KILN_BOOST_JAM_TARGET "${KILN_BOOST_JAMFILE_TARGET_${lib}}")
    endif()
    if(TARGET ${_KILN_BOOST_JAM_TARGET})
      get_property(subdirs DIRECTORY "${CMAKE_SOURCE_DIR}/libs/${lib}" PROPERTY SUBDIRECTORIES)
    endif()
    if(KILN_BOOST_JAMFILE_FORCE_${lib})
      set(subdirs "")
    endif()
    if(NOT TARGET ${_KILN_BOOST_JAM_TARGET} OR "${testdir}" IN_LIST subdirs)
      message(STATUS "kiln: ${lib}: no b2 tests registered (not built, or it has CMake tests)")
      continue()
    endif()
    if(DEFINED KILN_BOOST_JAMFILE_GLOB_${lib})
      foreach(item IN LISTS KILN_BOOST_JAMFILE_GLOB_${lib})
        string(REGEX MATCH "^([^=]+)=([^|]*)\\|?([^|]*)\\|?(.*)$" _ "${item}")
        set(type "${CMAKE_MATCH_1}")
        set(glob "${CMAKE_MATCH_2}")
        set(defs "${CMAKE_MATCH_3}")
        set(suffix "${CMAKE_MATCH_4}")
        if(glob MATCHES "^\\*\\*/(.*)$")
          file(GLOB_RECURSE srcs RELATIVE "${testdir}" "${testdir}/${CMAKE_MATCH_1}")
        else()
          file(GLOB srcs RELATIVE "${testdir}" "${testdir}/${glob}")
        endif()
        list(SORT srcs)
        if(DEFINED KILN_BOOST_JAMFILE_EXCLUDE_${lib})
          list(FILTER srcs EXCLUDE REGEX "${KILN_BOOST_JAMFILE_EXCLUDE_${lib}}")
        endif()
        foreach(src IN LISTS srcs)
          string(REGEX REPLACE "\\.[^.]*$" "" name "${src}")
          string(REPLACE "/" "_" name "${name}${suffix}")
          _kiln_boost_jam_add("${lib}" "${type}" "${testdir}/${src}" "${name}" "${defs}")
        endforeach()
      endforeach()
    else()
      file(GLOB_RECURSE jams "${testdir}/Jamfile" "${testdir}/Jamfile.v2" "${testdir}/Jamfile.jam")
      if(DEFINED KILN_BOOST_JAMFILE_SUBSET_${lib})
        # A dry pass collects every name; the subset is chosen from them.
        set(_KILN_BOOST_JAM_DRY ON)
        set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_ALL "")
        foreach(jam IN LISTS jams)
          _kiln_boost_jam_file("${lib}" "${testdir}" "${jam}")
        endforeach()
        set(_KILN_BOOST_JAM_DRY OFF)
        get_property(all DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_ALL)
        list(REMOVE_DUPLICATES all)
        list(SORT all)
        string(REGEX MATCH "^([0-9]+)\\|?(.*)$" _ "${KILN_BOOST_JAMFILE_SUBSET_${lib}}")
        set(every "${CMAKE_MATCH_1}")
        set(keepre "${CMAKE_MATCH_2}")
        set(_KILN_BOOST_JAM_KEEP "")
        set(i 0)
        foreach(n IN LISTS all)
          math(EXPR r "${i} % ${every}")
          if(r EQUAL 0 OR (NOT keepre STREQUAL "" AND n MATCHES "${keepre}"))
            list(APPEND _KILN_BOOST_JAM_KEEP "${n}")
          endif()
          math(EXPR i "${i} + 1")
        endforeach()
        list(LENGTH all nall)
        list(LENGTH _KILN_BOOST_JAM_KEEP nkeep)
        message(STATUS "kiln: ${lib}: subset ${nkeep} of ${nall} b2 test names (every ${every}, plus /${keepre}/)")
      endif()
      foreach(jam IN LISTS jams)
        _kiln_boost_jam_file("${lib}" "${testdir}" "${jam}")
      endforeach()
    endif()
    get_property(seen DIRECTORY "${CMAKE_SOURCE_DIR}" PROPERTY _KILN_BOOST_JAM_SEEN)
    list(FILTER seen INCLUDE REGEX "^${lib}-")
    list(LENGTH seen n)
    message(STATUS "kiln: ${lib}: ${n} b2 tests registered from test/Jamfile*")
  endforeach()
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _kiln_boost_jamfile_tests)

# KILN_BOOST_SUBSET_TARGETS `<regex>|<N>|<keep>` (WP-812): a deterministic
# subset of a suite too large to build whole (Boost.Geometry's ~400 test
# executables). Of the `tests` target's dependencies, those whose name
# matches <regex> are sorted and every N-th (the 1st, the N+1-th, ...) is
# kept, plus every one matching <keep>; all others are kept. The kept ones
# are the dependencies of the target `kiln_tests` (build it instead of
# `tests`), and the names of the dropped ones go to
# `<build>/kiln-subset-excluded.txt`, one per line, for `ctest
# --exclude-from-file` (a dropped target's test has the target's name).
function(_kiln_boost_subset_targets)
  if(NOT DEFINED KILN_BOOST_SUBSET_TARGETS OR NOT TARGET tests)
    return()
  endif()
  string(REPLACE "|" ";" parts "${KILN_BOOST_SUBSET_TARGETS}")
  list(APPEND parts "" "" "")
  list(GET parts 0 re)
  list(GET parts 1 every)
  list(GET parts 2 keepre)
  get_property(deps TARGET tests PROPERTY MANUALLY_ADDED_DEPENDENCIES)
  list(REMOVE_DUPLICATES deps)
  list(SORT deps)
  set(kept "")
  set(dropped "")
  set(i 0)
  set(nsub 0)
  foreach(t IN LISTS deps)
    if(NOT t MATCHES "${re}")
      list(APPEND kept "${t}")
      continue()
    endif()
    math(EXPR nsub "${nsub} + 1")
    math(EXPR r "${i} % ${every}")
    math(EXPR i "${i} + 1")
    if(r EQUAL 0 OR (NOT keepre STREQUAL "" AND t MATCHES "${keepre}"))
      list(APPEND kept "${t}")
    else()
      list(APPEND dropped "${t}")
    endif()
  endforeach()
  add_custom_target(kiln_tests)
  if(kept)
    add_dependencies(kiln_tests ${kept})
  endif()
  string(REPLACE ";" "\n" text "${dropped}")
  file(WRITE "${CMAKE_BINARY_DIR}/kiln-subset-excluded.txt" "${text}\n")
  list(LENGTH dropped ndrop)
  math(EXPR nkeep "${nsub} - ${ndrop}")
  message(STATUS "kiln: subset /${re}/: ${nkeep} of ${nsub} test targets kept (every ${every}, plus /${keepre}/)")
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _kiln_boost_subset_targets)
