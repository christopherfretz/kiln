#!/usr/bin/env python3
"""kiln-cxx: the logging C++ compiler wrapper of the OSS build harness.

Use it as CMAKE_CXX_COMPILER. It runs `$KILN_OSS_CXX` (default clang++-19)
with its own argv under an address-space cap and a timeout, passes stdout and
stderr through unchanged, and appends one JSON line per invocation to
`$KILN_OSS_LOG` (when set). The line's schema and the `kind` rules are the
contract in spec/landed/harness/WP-666.md.

Environment: KILN_OSS_CXX, KILN_OSS_LOG, KILN_OSS_PHASE (configure | build |
test, recorded as `phase`), KILN_OSS_VMEM_KB (default 3000000, the
`ulimit -v`), KILN_OSS_TIMEOUT (seconds, default 600), KILN_OSS_STDLIB
(`libc++` puts `-stdlib=libc++` before the argv, WP-694; unset or
`libstdc++` adds nothing), KILN_OSS_VERSION_SHIM (set by oss-build.sh for
meson rows, WP-920: see version_shim). Every invocation gets
`-fno-crash-diagnostics` first (WP-911), so a crashing compiler never writes
a reproducer to $TMPDIR for each crashing TU of a build.

`kiln-cc` (WP-1277) is this wrapper for C: `main(lang="c")` runs
`$KILN_OSS_CC` (default clang-19) and never adds `-stdlib=`. Every record
carries `lang`, the language of its primary source (`c++`, `c`, `asm`), or
the wrapper's own language for a link or no-source line.
"""

import fcntl
import json
import os
import re
import resource
import signal
import subprocess
import sys
import threading
import time

# Module interface units (.cppm and the other names CMake and the compilers
# accept) are TUs too (WP-1148).
CXX_EXT = (".cpp", ".cc", ".cxx", ".c++", ".cp", ".C", ".CPP", ".cppm", ".ccm", ".cxxm", ".c++m", ".ixx", ".mpp")
# C and assembler TUs (WP-1277): CMake hands `.S` to the C compiler when a
# project enables ASM and names no assembler. `.c` is C only through
# kiln-cc: a C++ compile of a `.c` file (the C++ wrapper's `-x c++`) is
# still recorded, under the language its `-x` names.
C_EXT = (".c", ".i")
ASM_EXT = (".S", ".s", ".sx")
SOURCE_EXT = CXX_EXT + C_EXT + ASM_EXT
# `-x <lang>` values, by the record's `lang`.
X_LANG = {
    "c++": "c++", "c++-header": "c++", "c++-cpp-output": "c++", "c++-module": "c++",
    "c": "c", "c-header": "c", "cpp-output": "c",
    "assembler": "asm", "assembler-with-cpp": "asm",
}
LINK_EXT = (".o", ".a", ".so", ".obj", ".lo")
DIAG_RE = re.compile(
    r"error:|panicked|internal compiler error|fatal|undefined reference|multiple definition|memory allocation of|LLVM ERROR"
)
OOM_RE = re.compile(
    r"memory allocation of \d+ bytes failed|out of memory|std::bad_alloc|Cannot allocate memory"
    r"|cannot create the compile thread"
)
SILENT_SPAWN_RC = 70
HEAD_CAP = 256 * 1024
TAIL_CAP = 64 * 1024


def primary_source(args, exts=CXX_EXT):
    """The first source argument (an `exts` name, or any source name after
    `-x <lang>`), else 'link' when there are linker inputs (objects,
    archives, response files), else 'none'."""
    return source_and_lang(args, exts)[0]


def lang_of_ext(path):
    if path.endswith(CXX_EXT):
        return "c++"
    if path.endswith(C_EXT):
        return "c"
    if path.endswith(ASM_EXT):
        return "asm"
    return None


def source_and_lang(args, exts=CXX_EXT, default_lang="c++"):
    """(primary source, its language). The language is the `-x` in force at
    the source, else its extension's; a link or no-source line has the
    wrapper's own language."""
    skip = False
    xlang = None
    for i, a in enumerate(args):
        if skip:
            skip = False
            continue
        if a == "-x" and i + 1 < len(args):
            v = args[i + 1]
            xlang = None if v == "none" else X_LANG.get(v, v)
            skip = True
            continue
        if a.startswith("-x") and len(a) > 2:
            v = a[2:]
            xlang = None if v == "none" else X_LANG.get(v, v)
            continue
        if a in ("-o", "-MF", "-MT", "-MQ", "-include", "-I", "-isystem", "-D", "-U"):
            skip = True
            continue
        if a.startswith("-") or a.startswith("@"):
            continue
        if xlang is not None and a.endswith(SOURCE_EXT):
            return a, xlang
        if a.endswith(exts):
            return a, lang_of_ext(a)
    if any(a.endswith(LINK_EXT) or a.startswith("@") for a in args) and not any(
        a in ("-E", "-c", "-S", "-fsyntax-only") for a in args
    ):
        return "link", default_lang
    return "none", default_lang


def output_of(args):
    for i, a in enumerate(args):
        if a == "-o" and i + 1 < len(args):
            return args[i + 1]
        if a.startswith("-o") and len(a) > 2:
            return a[2:]
    return None


def first_diag(text):
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if DIAG_RE.search(line):
            if "panicked at" in line and i + 1 < len(lines):
                line = line.rstrip() + " | " + lines[i + 1].strip()
            return line.strip()[:500]
    return ""


def classify(rc, timed_out, text, source):
    if timed_out:
        return "timeout"
    if rc == 0:
        return "ok"
    if OOM_RE.search(text):
        return "oom"
    # kiln's crash banner (WP-911, spec/driver.md "Internal compiler
    # errors") or Rust's default panic report from an older kiln++.
    if (
        "internal compiler error: " in text
        or "panicked at" in text
        or "has overflowed its stack" in text
        or rc == 101
    ):
        return "panic"
    if rc < 0:
        return "oom" if rc == -signal.SIGKILL else "panic"
    if rc == SILENT_SPAWN_RC and not text.strip():
        # kiln++ before WP-682 exited 70 without a word when it could not
        # spawn its compile thread (a 1 GiB stack reservation,
        # crates/kiln_driver/src/main.rs): under the address-space cap that
        # is memory. It now says `cannot create the compile thread` (OOM_RE).
        return "oom"
    if "backend command failed" in text or "LLVM ERROR" in text:
        return "backend"
    if (
        "linker command failed" in text
        or "undefined reference" in text
        or "multiple definition" in text
        or (source == "link" and "error:" not in text)
    ):
        return "link"
    if "error:" in text:
        return "reject"
    return "other"


def version_shim(cxx):
    """Meson's compiler detection (mesonbuild/compilers/detect.py) needs
    `clang` or `Clang` somewhere in `--version`'s stdout and takes the first
    `N.N[.N]` token there as the clang version; kiln's own banner says
    `kiln version 0.0.1` and no `clang` (operator decision Q3, WP-920,
    docs/COMPATIBILITY.md "Build systems"). For meson rows only, the harness
    puts one line naming the clang compatibility level (`-dumpversion`)
    before that banner. It is the harness's line, not kiln's: kiln++ never
    prints it. Returns the exit status, or None to run the compiler as
    usual (it already says clang)."""
    try:
        real = subprocess.run([cxx, "--version"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if real.returncode != 0 or "clang" in real.stdout or "Clang" in real.stdout:
        return None
    try:
        ver = subprocess.run([cxx, "-dumpversion"], capture_output=True, text=True, timeout=60).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    sys.stdout.write(f"clang-compatible {ver} (kiln-cxx Meson shim, WP-920)\n{real.stdout}")
    sys.stderr.write(real.stderr)
    return 0


def main(lang="c++"):
    args = sys.argv[1:]
    me = "kiln-cc" if lang == "c" else "kiln-cxx"
    if lang == "c":
        cxx = os.environ.get("KILN_OSS_CC") or "clang-19"
        stdlib = "libstdc++"  # C has no standard library choice to make
    else:
        cxx = os.environ.get("KILN_OSS_CXX") or "clang++-19"
        stdlib = os.environ.get("KILN_OSS_STDLIB") or "libstdc++"
    if stdlib not in ("libstdc++", "libc++"):
        sys.stderr.write(f"kiln-cxx: KILN_OSS_STDLIB must be libstdc++ or libc++, not '{stdlib}'\n")
        return 2
    if args == ["--version"] and os.environ.get("KILN_OSS_VERSION_SHIM"):
        rc = version_shim(cxx)
        if rc is not None:
            return rc
    # libc++ mode (WP-694): the flag goes first so a project's own
    # `-stdlib=` (the last one wins) still decides.
    cmd = [cxx, "-fno-crash-diagnostics"] + (["-stdlib=libc++"] if stdlib == "libc++" else []) + args
    log = os.environ.get("KILN_OSS_LOG")
    vmem_kb = int(os.environ.get("KILN_OSS_VMEM_KB") or 3000000)
    limit_s = float(os.environ.get("KILN_OSS_TIMEOUT") or 600)

    def cap():
        lim = vmem_kb * 1024
        soft, hard = resource.getrlimit(resource.RLIMIT_AS)
        if hard != resource.RLIM_INFINITY:
            lim = min(lim, hard)
        resource.setrlimit(resource.RLIMIT_AS, (lim, hard))

    start = time.monotonic()
    try:
        proc = subprocess.Popen(cmd, stderr=subprocess.PIPE, preexec_fn=cap, start_new_session=True)
    except OSError as e:
        sys.stderr.write(f"{me}: cannot run {cxx}: {e}\n")
        return 127

    timed_out = threading.Event()

    def kill_group(sig=signal.SIGKILL):
        try:
            os.killpg(proc.pid, sig)
        except ProcessLookupError:
            pass

    def on_timeout():
        timed_out.set()
        kill_group()

    timer = threading.Timer(limit_s, on_timeout)
    timer.daemon = True
    timer.start()

    def forward(signum, _frame):
        kill_group(signum)

    for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(s, forward)

    head = bytearray()
    tail = bytearray()
    err_out = sys.stderr.buffer
    while True:
        chunk = proc.stderr.read1(65536)
        if not chunk:
            break
        err_out.write(chunk)
        err_out.flush()
        if len(head) < HEAD_CAP:
            head += chunk[: HEAD_CAP - len(head)]
        else:
            tail += chunk
            if len(tail) > TAIL_CAP:
                del tail[: len(tail) - TAIL_CAP]
    rc = proc.wait()
    timer.cancel()
    wall = time.monotonic() - start
    ru = resource.getrusage(resource.RUSAGE_CHILDREN)
    rss_kb = ru.ru_maxrss
    cpu = ru.ru_utime + ru.ru_stime

    if log:
        text = head.decode("utf-8", "replace") + "\n" + tail.decode("utf-8", "replace")
        source, src_lang = source_and_lang(args, SOURCE_EXT if lang == "c" else CXX_EXT, lang)
        diag = first_diag(text)
        if not diag and timed_out.is_set():
            diag = f"timed out after {limit_s:g} s"
        elif not diag and rc < 0:
            diag = f"killed by signal {-rc}"
        elif not diag and rc == SILENT_SPAWN_RC and not text.strip():
            diag = "exit 70 without output (compile thread not spawned)"
        rec = {
            "v": 1,
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "phase": os.environ.get("KILN_OSS_PHASE", ""),
            "cwd": os.getcwd(),
            "argv": cmd,
            "source": source,
            "lang": src_lang,
            "output": output_of(args),
            "rc": rc,
            "wall_s": round(wall, 3),
            "cpu_s": round(cpu, 3),
            "max_rss_kb": rss_kb,
            "diag": diag,
            "kind": classify(rc, timed_out.is_set(), text, source),
        }
        line = (json.dumps(rec, ensure_ascii=False) + "\n").encode("utf-8")
        with open(log, "ab") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(line)
            fcntl.flock(f, fcntl.LOCK_UN)

    if timed_out.is_set():
        return 124
    return rc if rc >= 0 else 128 - rc


if __name__ == "__main__":
    sys.exit(main())
