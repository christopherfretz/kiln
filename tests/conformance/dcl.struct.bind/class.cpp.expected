  | `-DecompositionDecl used 'D' cinit
  |   |-CXXConstructExpr 'D' 'void (const D &) noexcept'
  |   | `-ImplicitCastExpr 'const D' lvalue <NoOp>
  |   |   `-DeclRefExpr 'D' lvalue ParmVar 'd' 'D'
  |   |-BindingDecl referenced x 'int'
  |   | `-MemberExpr 'int' lvalue .x
  |   |   `-ImplicitCastExpr 'B' lvalue <UncheckedDerivedToBase (B)>
  |   |     `-DeclRefExpr 'D' lvalue Decomposition '' 'D'
  |   `-BindingDecl referenced y 'long'
  |     `-MemberExpr 'long' lvalue .y
  |       `-ImplicitCastExpr 'B' lvalue <UncheckedDerivedToBase (B)>
  |         `-DeclRefExpr 'D' lvalue Decomposition '' 'D'
  `-ReturnStmt
    `-BinaryOperator 'int' '+'
      |-ImplicitCastExpr 'int' <LValueToRValue>
      | `-DeclRefExpr 'int' lvalue Binding 'x' 'int'
      `-CXXFunctionalCastExpr 'int' functional cast to int <NoOp>
        `-ImplicitCastExpr 'int' <IntegralCast> part_of_explicit_cast
          `-ImplicitCastExpr 'long' <LValueToRValue> part_of_explicit_cast
            `-DeclRefExpr 'long' lvalue Binding 'y' 'long'

