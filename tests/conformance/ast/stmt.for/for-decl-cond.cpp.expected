TranslationUnitDecl
`-FunctionDecl sum 'int (int)'
  |-ParmVarDecl used n 'int'
  `-CompoundStmt
    |-DeclStmt
    | `-VarDecl used s 'int' cinit
    |   `-IntegerLiteral 'int' 0
    |-ForStmt has_init has_cond has_inc
    | |-DeclStmt
    | | |-VarDecl used i 'int' cinit
    | | | `-IntegerLiteral 'int' 0
    | | `-VarDecl used j 'int' cinit
    | |   `-ImplicitCastExpr 'int' <LValueToRValue>
    | |     `-DeclRefExpr 'int' lvalue ParmVar 'n' 'int'
    | |-BinaryOperator 'bool' '<'
    | | |-ImplicitCastExpr 'int' <LValueToRValue>
    | | | `-DeclRefExpr 'int' lvalue Var 'i' 'int'
    | | `-ImplicitCastExpr 'int' <LValueToRValue>
    | |   `-DeclRefExpr 'int' lvalue Var 'j' 'int'
    | |-BinaryOperator 'int' lvalue ','
    | | |-UnaryOperator 'int' lvalue prefix '++'
    | | | `-DeclRefExpr 'int' lvalue Var 'i' 'int'
    | | `-UnaryOperator 'int' lvalue prefix '--'
    | |   `-DeclRefExpr 'int' lvalue Var 'j' 'int'
    | `-CompoundAssignOperator 'int' lvalue '+=' ComputeLHSTy='int' ComputeResultTy='int'
    |   |-DeclRefExpr 'int' lvalue Var 's' 'int'
    |   `-BinaryOperator 'int' '*'
    |     |-ImplicitCastExpr 'int' <LValueToRValue>
    |     | `-DeclRefExpr 'int' lvalue Var 'i' 'int'
    |     `-ImplicitCastExpr 'int' <LValueToRValue>
    |       `-DeclRefExpr 'int' lvalue Var 'j' 'int'
    |-ForStmt has_cond
    | |-ImplicitCastExpr 'bool' <IntegralToBoolean>
    | | `-ImplicitCastExpr 'int' <LValueToRValue>
    | |   `-DeclRefExpr 'int' lvalue ParmVar 'n' 'int'
    | `-UnaryOperator 'int' lvalue prefix '--'
    |   `-DeclRefExpr 'int' lvalue ParmVar 'n' 'int'
    |-ForStmt has_init has_var has_cond has_inc
    | |-DeclStmt
    | | `-VarDecl used k 'int' cinit
    | |   `-IntegerLiteral 'int' 3
    | |-DeclStmt
    | | `-VarDecl used left 'int' cinit
    | |   `-ImplicitCastExpr 'int' <LValueToRValue>
    | |     `-DeclRefExpr 'int' lvalue Var 'k' 'int'
    | |-ImplicitCastExpr 'bool' <IntegralToBoolean>
    | | `-ImplicitCastExpr 'int' <LValueToRValue>
    | |   `-DeclRefExpr 'int' lvalue Var 'left' 'int'
    | |-UnaryOperator 'int' lvalue prefix '--'
    | | `-DeclRefExpr 'int' lvalue Var 'k' 'int'
    | `-CompoundAssignOperator 'int' lvalue '+=' ComputeLHSTy='int' ComputeResultTy='int'
    |   |-DeclRefExpr 'int' lvalue Var 's' 'int'
    |   `-ImplicitCastExpr 'int' <LValueToRValue>
    |     `-DeclRefExpr 'int' lvalue Var 'left' 'int'
    |-ForStmt
    | `-BreakStmt
    `-ReturnStmt
      `-ImplicitCastExpr 'int' <LValueToRValue>
        `-ImplicitCastExpr 'int' xvalue <NoOp>
          `-DeclRefExpr 'int' lvalue Var 's' 'int'
