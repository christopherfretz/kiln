| `-CXXConstructorDecl used M 'void (Arg)'
|   `-ParmVarDecl 'Arg':'M::Arg'
|-CXXRecordDecl referenced struct C definition
| |-CXXConstructorDecl used C 'void ()'
| `-CXXConstructorDecl used C 'void (int)'
|   `-ParmVarDecl 'int'
|-VarDecl used g 'int'
