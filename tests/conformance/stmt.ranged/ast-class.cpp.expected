|-CXXRecordDecl referenced struct R definition
| |-FieldDecl d 'int[2]'
| |-CXXMethodDecl used begin 'int *()'
| `-CXXMethodDecl used end 'int *()'
`-FunctionDecl sum_class 'int (R)'
