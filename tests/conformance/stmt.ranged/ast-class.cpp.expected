    | |-UnaryOperator 'int *' lvalue prefix '++'
    | | `-DeclRefExpr 'int *' lvalue Var '__begin1' 'int *'
    | |-DeclStmt
    | | `-VarDecl used x 'int &' cinit
    | |   `-UnaryOperator 'int' lvalue prefix '*' cannot overflow
    | |     `-ImplicitCastExpr 'int *' <LValueToRValue>
    | |       `-DeclRefExpr 'int *' lvalue Var '__begin1' 'int *'
    | `-CompoundAssignOperator 'int' lvalue '+=' ComputeLHSTy='int' ComputeResultTy='int'
    |   |-DeclRefExpr 'int' lvalue Var 's' 'int'
    |   `-ImplicitCastExpr 'int' <LValueToRValue>
    |     `-DeclRefExpr 'int' lvalue Var 'x' 'int &'
    |-CXXForRangeStmt
    | |-DeclStmt
