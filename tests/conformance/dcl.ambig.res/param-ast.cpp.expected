| `-ParmVarDecl a 'T'
|-FunctionDecl s13 'void ()'
| `-CompoundStmt
|   `-DeclStmt
|     `-FunctionDecl g2 'void (T)'
|       `-ParmVarDecl a 'T'
|-FunctionDecl g3 'void (T (*)(U))'
| `-ParmVarDecl 'T (*)(U)'
|-FunctionDecl g4 'void (T (*)(U))'
| `-ParmVarDecl 'T (*)(U)'
