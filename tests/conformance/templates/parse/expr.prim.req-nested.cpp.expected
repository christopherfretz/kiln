|-ConceptDecl Small
| |-TemplateTypeParmDecl referenced class depth 0 index 0 T
| `-BinaryOperator 'bool' '<='
|   |-UnaryExprOrTypeTraitExpr 'unsigned long' sizeof 'T'
|   `-ImplicitCastExpr 'unsigned long' <IntegralCast>
|     `-IntegerLiteral 'int' 8
`-ConceptDecl C
  |-TemplateTypeParmDecl referenced class depth 0 index 0 T
  `-RequiresExpr 'bool'
