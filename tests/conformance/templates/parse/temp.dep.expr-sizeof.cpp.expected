TranslationUnitDecl
|-FunctionTemplateDecl s
| |-TemplateTypeParmDecl referenced class depth 0 index 0 T
| `-FunctionDecl s 'unsigned long ()'
|   `-CompoundStmt
|     `-ReturnStmt
|       `-BinaryOperator '__size_t':'unsigned long' '+'
|         |-UnaryExprOrTypeTraitExpr '__size_t':'unsigned long' sizeof 'T'
|         `-UnaryExprOrTypeTraitExpr '__size_t':'unsigned long' alignof 'T'
`-FunctionTemplateDecl e
  |-TemplateTypeParmDecl referenced class depth 0 index 0 T
  `-FunctionDecl e 'unsigned long (T)'
    |-ParmVarDecl referenced t 'T'
    `-CompoundStmt
      `-ReturnStmt
        `-UnaryExprOrTypeTraitExpr '__size_t':'unsigned long' sizeof
          `-DeclRefExpr 'T' lvalue ParmVar 't' 'T' non_odr_use_unevaluated
