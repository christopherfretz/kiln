|   `-ParmVarDecl 'const M &'
|-FunctionDecl choose 'M (M)'
| |-ParmVarDecl used m 'M'
| `-CompoundStmt
|   `-ReturnStmt
|     `-CXXConstructExpr 'M' 'void (M &&) noexcept'
|       `-ImplicitCastExpr 'M' xvalue <NoOp>
|         `-ParenExpr 'M' lvalue
