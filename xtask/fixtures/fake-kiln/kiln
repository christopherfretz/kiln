#!/bin/sh
# A stand-in for kiln, for the harness self-tests (`xtask/src/test/tests.rs`,
# `xtask/src/bench/tests.rs`). It identifies as kiln, so the harness passes
# `-fconstexpr-report=<path>`; it strips that flag, writes the canned report
# `<source>.oven.jsonl` (if there is one) to <path> with `@SRC@` replaced by
# the source path as given, and compiles with ${KILN_FAKE_CC:-clang++-19}.
if [ "$1" = "--version" ]; then
  echo "kiln version 0.0.0-fake (xtask fixture)"
  exit 0
fi
report=
src=
for a in "$@"; do
  shift
  case "$a" in
    -fconstexpr-report=*) report=${a#-fconstexpr-report=} ;;
    *.cpp | *.c | *.h) src=$a; set -- "$@" "$a" ;;
    *) set -- "$@" "$a" ;;
  esac
done
if [ -n "$report" ] && [ -n "$src" ] && [ -f "$src.oven.jsonl" ]; then
  sed "s|@SRC@|$src|g" "$src.oven.jsonl" >"$report" || exit 70
fi
exec "${KILN_FAKE_CC:-clang++-19}" "$@"
