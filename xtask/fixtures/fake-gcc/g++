#!/bin/sh
# A stand-in for GCC 16.1, for the GCC-oracle self-tests
# (`xtask/src/test/tests.rs`, spec/harness.md "GCC oracle"). It identifies
# as GCC and acts on a `// fake-gcc: <what>` line in the source:
#   ice     reports an internal compiler error (exit 4)
#   sorry   reports `sorry, unimplemented` (exit 1)
#   signal  dies of SIGSEGV
#   reject  reports an error (exit 1)
#   accept  exits 0 without compiling
# Otherwise it compiles with ${KILN_FAKE_CC:-clang++-19} and -DKILN_FAKE_GCC,
# so a test can make GCC's binary behave differently. Like GCC 16.1 it
# rejects the kiln/clang flags the harness must not pass it
# (`--gcc-toolchain=`, `-ferror-limit=`, `-fclang-compat=`, `-fkiln-*`,
# `-Qunused-arguments`, `-fno-crash-diagnostics`, `-R<remark>`, and a
# `-W<name>`/`-Werror=<name>` naming a warning outside its short
# `-Q --help=warnings` list; spec/harness.md "GCC as the compiler under
# test"), as well as `-fsanitize-ignorelist=` (a clang flag the harness
# cannot map, for the flag probe), and it drops GCC's own
# `-fmax-errors=`/`-fconstexpr-ops-limit=` and `-lstdc++exp` before calling
# clang.
if [ "$1" = "--version" ]; then
  echo "g++ (GCC) 16.1.0-fake (xtask fixture)"
  exit 0
fi
case " $* " in
  *" --help=warnings "*)
    echo "The following options control compiler warning messages:"
    echo "  -Wall                       		[disabled]"
    echo "  -Wextra                     		[disabled]"
    echo "  -Wformat=<0,2>              		0"
    echo "  -Wpedantic                  		[disabled]"
    echo "  -Wunused-variable           		[disabled]"
    echo "  -Wmissing-prototypes        		[available in C, ObjC]"
    exit 0
    ;;
esac
known=" all extra format pedantic unused-variable "
src=
n=$#
while [ "$n" -gt 0 ]; do
  a=$1
  shift
  n=$((n - 1))
  case "$a" in
    --gcc-toolchain=* | -ferror-limit=* | -fclang-compat=* | -fkiln-* | \
      -Qunused-arguments | -fno-crash-diagnostics | -fcrash-diagnostics* | -R[a-z]* | \
      -fsanitize-ignorelist=*)
      echo "g++: error: unrecognized command-line option '$a'" >&2
      exit 1
      ;;
    -W | -Werror | -Wno-* | -W?,*) ;;
    -W*)
      w=${a#-W}
      w=${w#error=}
      w=${w%%=*}
      case "$known" in
        *" $w "*) ;;
        *)
          echo "g++: error: unrecognized command-line option '$a'" >&2
          exit 1
          ;;
      esac
      ;;
    -fmax-errors=* | -fconstexpr-ops-limit=* | -lstdc++exp) continue ;;
    *.cpp | *.c | *.h) src=$a ;;
  esac
  set -- "$@" "$a"
done
what=$(sed -n 's|^// fake-gcc: *||p' "$src" 2>/dev/null | head -n 1)
case "$what" in
  ice)
    echo "$src:1:1: internal compiler error: Segmentation fault" >&2
    exit 4
    ;;
  sorry)
    echo "$src:1:1: sorry, unimplemented: reflection on this construct" >&2
    exit 1
    ;;
  signal) kill -SEGV $$ ;;
  reject)
    echo "$src:1:1: error: fake rejection" >&2
    exit 1
    ;;
  accept) exit 0 ;;
esac
exec "${KILN_FAKE_CC:-clang++-19}" -DKILN_FAKE_GCC "$@"
