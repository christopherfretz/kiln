# build output and workspace-local toolchain
/target/
/.toolchain/
# supervisor-created worktrees for implementer agents
/.worktrees/

# cargo xtask bench run records (baselines under bench/baselines are committed)
/bench/results/

# implementer scratch space (per-WP notes, logs, local binaries); never committed
/scratchpad/

# OSS build harness checkouts, build trees and reports (scripts/oss/)
/.oss/
__pycache__/

# the kiln_hod workspace's build output, if built without CARGO_TARGET_DIR
/kiln_hod/target/
